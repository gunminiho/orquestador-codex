{
  "compilerOptions": {
    "target": "ES2022",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "types": [
      "node"
    ],

    "strict": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "sourceMap": true,

    "skipLibCheck": true,

    "noEmit": true
  },

  "include": [
    "src/**/*.ts",
    "schemas/**/*.ts"
  ]
}